# ============================================================
# GDG Jobs — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com seus dados
# NUNCA commit .env.local! Já está no .gitignore
# ============================================================

# ─────────────────────────────────────────────────────────────
# FIREBASE AUTH (Client-side — prefixo NEXT_PUBLIC_)
# Pegue em: Firebase Console → Project Settings → Geral
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# SUPABASE (Client-side — prefixo NEXT_PUBLIC_)
# Pegue em: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...anon-key-publica

# ─────────────────────────────────────────────────────────────
# SUPABASE (Server-side only — SEM prefixo NEXT_PUBLIC)
# ⚠️ NUNCA exponha esta chave no frontend!
# Pegue em: Supabase Dashboard → Project Settings → API → service role
# ─────────────────────────────────────────────────────────────

SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...service-role-secreta

# ─────────────────────────────────────────────────────────────
# RESEND (opcional — para alertas por e-mail na V2)
# Pegue em: https://resend.com → API Keys
# ─────────────────────────────────────────────────────────────

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx